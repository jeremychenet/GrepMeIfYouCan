---
// About and Privacy pages arrive in J15; links are in place already.
import { REPO_URL } from '../lib/github';
---

<footer class="site-footer">
  <div class="container inner">
    <nav aria-label="Footer">
      <ul>
        <li><a href="/about">About</a></li>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href={REPO_URL} rel="noopener">GitHub</a></li>
      </ul>
    </nav>
    <p class="muted">
      Many examples are adapted from <a href="https://github.com/tldr-pages/tldr" rel="noopener"
        >tldr-pages</a
      >, licensed under <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener"
        >CC BY 4.0</a
      >.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-4);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  ul a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }

  @media (min-width: 640px) {
    .inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-6);
    }
  }
</style>
