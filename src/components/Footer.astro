---
// Site links, the global "Suggest a command" (prefilled GitHub issue form,
// SPEC §2.9) and the tldr-pages attribution.
import { REPO_URL, suggestCommandUrl } from '../lib/github';
import NewTab from './NewTab.astro';
---

<footer class="site-footer">
  <div class="container inner">
    <nav aria-label="Footer">
      <ul>
        <li><a href="/about">About</a></li>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href={REPO_URL} rel="noopener">GitHub</a></li>
        <li>
          <a href={suggestCommandUrl()} target="_blank" rel="noopener" data-suggest-global
            >Suggest a command<NewTab /></a
          >
        </li>
      </ul>
    </nav>
    <button type="button" class="shortcuts-button" hidden data-shortcuts-open>
      Keyboard shortcuts <kbd>?</kbd>
    </button>
    <p>
      Many examples are adapted from <a href="https://github.com/tldr-pages/tldr" rel="noopener"
        >tldr-pages</a
      >, licensed under <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener"
        >CC BY 4.0</a
      >.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    color: var(--color-text-muted);
    border-top: var(--rule-width) solid var(--color-border-strong);
    font-size: var(--text-sm);
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-block: var(--space-2) var(--space-3);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
  }

  a {
    color: var(--color-text);
  }

  ul a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--tap-min);
    min-height: var(--tap-min);
  }

  .shortcuts-button {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-min);
    padding: 0;
    color: var(--color-text);
    background: none;
    border: 0;
    font-family: var(--font-mono);
    font-size: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .shortcuts-button:hover {
    color: var(--color-accent);
  }

  p {
    max-width: var(--prose-max);
    font-size: var(--text-xs);
  }

  @media (min-width: 640px) {
    .shortcuts-button {
      align-self: auto;
    }

    .inner {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-2) var(--space-6);
    }
  }
</style>
