---
// Favorites and History live in this browser only (SPEC §2.8).
const nav = [
  { href: '/', label: 'Search' },
  { href: '/favorites', label: 'Favorites' },
  { href: '/history', label: 'History' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="GrepMeIfYouCan, home">
      <span aria-hidden="true">grepmeifyoucan</span><b class="cursor" aria-hidden="true"></b>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={path === href ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch theme">
      <!-- Sun shown in dark theme (action: go light), moon in light theme. -->
      <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <path
          d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
      <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path
          d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  import './ThemeToggle';
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-bg);
    border-bottom: var(--rule-width) solid var(--color-border-strong);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--header-height);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text);
    text-decoration: none;
  }

  .cursor {
    display: inline-block;
    width: 0.58em;
    height: 1.05em;
    margin-left: 0.15em;
    background: var(--color-accent-fill);
  }

  nav {
    margin-right: auto;
    margin-left: var(--space-4);
  }

  nav ul {
    display: flex;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding-inline: var(--space-2);
    color: var(--color-text);
    font-size: var(--text-md);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: var(--rule-width);
    text-underline-offset: 6px;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap-min);
    height: var(--tap-min);
    padding: 0;
    color: var(--color-text);
    background: none;
    border: 0;
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--color-bg);
    background: var(--color-text);
  }

  /* Without JS the toggle cannot work: theme-init.js sets data-theme, so the
     button stays hidden (but keeps its space) when it has not run. */
  :global(html:not([data-theme])) .theme-toggle {
    visibility: hidden;
  }

  :global([data-theme='light']) .icon-sun,
  :global([data-theme='dark']) .icon-moon {
    display: none;
  }

  /* Small phones: the wordmark alone, nav links stay reachable. */
  @media (max-width: 479px) {
    .brand span {
      font-size: var(--text-base);
    }

    nav {
      margin-left: var(--space-1);
    }

    /* The wordmark already leads to the search. */
    nav li:first-child {
      display: none;
    }

    nav a {
      padding-inline: var(--space-1);
      font-size: var(--text-sm);
    }
  }

  @media (min-width: 1024px) {
    nav {
      margin-left: var(--space-12);
    }

    nav ul {
      gap: var(--space-4);
    }
  }
</style>
