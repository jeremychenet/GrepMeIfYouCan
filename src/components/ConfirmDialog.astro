---
// Confirmation before the first copy of a destructive command in the session
// (SPEC §2.7, §7.3). Shows the exact text that will be copied.
// src/components/ConfirmDialog.ts opens it.
---

<dialog class="confirm" aria-labelledby="confirm-title" aria-describedby="confirm-text" data-confirm>
  <form method="dialog">
    <h2 id="confirm-title">Copy a destructive command?</h2>
    <p id="confirm-text">
      This command can permanently delete data. Check every value before running it.
    </p>
    <pre class="command"><code data-confirm-command></code></pre>
    <div class="buttons">
      <button type="submit" value="cancel" class="btn" autofocus>Cancel</button>
      <button type="submit" value="copy" class="btn btn--danger">Copy anyway</button>
    </div>
  </form>
</dialog>

<style>
  .confirm {
    /* The global reset removes the margin that centers a modal dialog. */
    margin: auto;
    width: min(38rem, calc(100% - 2 * var(--space-4)));
    padding: 0;
    color: var(--color-text);
    background: var(--color-bg);
    border: var(--rule-width) solid var(--color-border-strong);
    border-left: 6px solid var(--color-destructive);
    border-radius: 0;
  }

  .confirm::backdrop {
    background: rgb(21 21 19 / 70%);
  }

  form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
  }

  h2 {
    color: var(--color-destructive);
    font-family: var(--font-cond);
    font-size: var(--text-xl);
  }

  .command {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    color: var(--color-term-text);
    background: var(--color-term-bg);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-3);
  }
</style>
