---
// List of compact cards as numbered rows (01, 02…), one per line, across the
// whole width. On keyboard devices, src/components/KeyboardNav.ts moves the
// focus from card to card with the arrow keys (it stays a plain list, so the
// links, values and buttons of each card stay reachable); the active row
// (aria-current) gets the orange bar, the larger command and the key hint.
interface Props {
  /** Accessible name of the list. */
  label?: string;
}

const { label = 'Commands' } = Astro.props;
---

<ul class="card-list" aria-label={label} data-card-list>
  <slot />
</ul>

<style>
  .card-list {
    margin-inline: calc(-1 * var(--gutter));
    padding: 0;
    list-style: none;
    counter-reset: row;
  }

  .card-list > :global(li) {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-5) var(--gutter);
    border-bottom: 1px solid var(--color-border);
    border-left: 6px solid transparent;
    padding-left: calc(var(--gutter) - 6px);
    counter-increment: row;
    /* Keeps the active row clear of the sticky header and key bar. */
    scroll-margin-block: calc(var(--header-height) + var(--space-2)) var(--space-12);
  }

  .card-list > :global(li)::before {
    content: counter(row, decimal-leading-zero);
    align-self: center;
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  /* The active row (keyboard): orange bar, tinted background. */
  .card-list > :global([aria-current='true']) {
    background: var(--color-surface);
    border-left-color: var(--color-focus);
  }

  .card-list > :global([aria-current='true'])::before {
    color: var(--color-accent);
  }

  /* Touch screens: no "active row" (a keyboard notion). */
  @media (hover: none), (pointer: coarse) {
    .card-list > :global([aria-current='true']) {
      background: none;
      border-left-color: transparent;
    }

    .card-list > :global([aria-current='true'])::before {
      color: var(--color-text-faint);
    }
  }

  /* A focused card shows the orange bar of its row instead of an outline. */
  .card-list > :global(li) > :global(article:focus-visible) {
    outline: none;
  }

  /* Narrow screens: the number sits on the title line. */
  @media (max-width: 639px) {
    .card-list > :global(li) {
      grid-template-columns: 1.5rem minmax(0, 1fr);
      gap: var(--space-2);
      padding-block: var(--space-3) var(--space-4);
    }

    .card-list > :global(li)::before {
      align-self: start;
      padding-top: 0.75rem;
      font-size: var(--text-xs);
    }
  }

  @media (min-width: 1024px) {
    .card-list > :global(li) {
      grid-template-columns: 3rem minmax(0, 1fr);
      gap: var(--space-5);
    }
  }
</style>
