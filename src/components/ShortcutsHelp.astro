---
// Keyboard shortcuts help (SPEC §3.2), opened with `?` or the footer button.
// src/components/ShortcutsHelp.ts opens it; touch screens never show it.
import { SHORTCUTS } from '../lib/keyboard';
---

<dialog class="shortcuts" aria-labelledby="shortcuts-title" data-shortcuts>
  <form method="dialog">
    <h2 id="shortcuts-title">Keyboard shortcuts</h2>
    <dl>
      {
        SHORTCUTS.map(({ keys, label }) => (
          <div>
            <dt>
              {keys.map((k, i) => (
                <>
                  {i > 0 && <span class="or"> or </span>}
                  <kbd>{k}</kbd>
                </>
              ))}
            </dt>
            <dd>{label}</dd>
          </div>
        ))
      }
    </dl>
    <p class="note">
      Values you edit carry over to the same value of the other commands, except on destructive
      commands, where they are always typed by hand.
    </p>
    <div class="buttons">
      <button type="submit" class="btn" autofocus>Close</button>
    </div>
  </form>
</dialog>

<script>
  import './ShortcutsHelp';
</script>

<style>
  .shortcuts {
    /* The global reset removes the margin that centers a modal dialog. */
    margin: auto;
    width: min(40rem, calc(100% - 2 * var(--space-4)));
    padding: 0;
    color: var(--color-text);
    background: var(--color-bg);
    border: var(--rule-width) solid var(--color-border-strong);
    border-radius: 0;
  }

  .shortcuts::backdrop {
    background: rgb(21 21 19 / 70%);
  }

  form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
  }

  h2 {
    font-family: var(--font-cond);
    font-size: var(--text-xl);
  }

  dl {
    display: grid;
    border-top: 1px solid var(--color-border);
  }

  dl div {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  dt {
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .or {
    color: var(--color-text-faint);
  }

  @media (min-width: 640px) {
    dl div {
      grid-template-columns: 12rem 1fr;
      align-items: baseline;
      gap: var(--space-4);
    }
  }

  dd {
    margin: 0;
    color: var(--color-text-muted);
  }

  .note {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .buttons {
    display: flex;
    justify-content: flex-end;
  }
</style>
