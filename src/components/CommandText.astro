---
// A command with its template variables highlighted in yellow (editable
// fields once src/components/CommandTemplate.ts has run).
// Variables show their default value when they have one, else their name.
// `scroll`: long commands scroll inside the block (card page); the block is
// then focusable so keyboard users can scroll it (WCAG 2.1.1). Otherwise
// they wrap, which keeps lists free of extra tab stops.
import { parseTemplate } from '../lib/template';

interface Props {
  command: string;
  scroll?: boolean;
}

const { command, scroll = false } = Astro.props;
const segments = parseTemplate(command);
---

<pre
  class:list={['command', { wrap: !scroll }]}
  tabindex={scroll ? 0 : undefined}
  aria-label={scroll ? 'Command' : undefined}><code>{
  segments.map((s) =>
    s.type === 'text' ? (
      s.value
    ) : (
      <var data-var={s.name} title={s.name}>{s.default ?? s.name}</var>
    ),
  )
}</code></pre>

<style>
  .command {
    margin: 0;
    color: var(--color-text);
    font-size: 1em;
    line-height: 1.6;
  }

  .wrap {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  /* A value to adapt, before CommandTemplate.ts turns it into a field: the
     same unbreakable box as the field (.var-input in global.css, including
     its 2px for the caret), so lines do not rewrap when it is replaced (CLS). */
  var {
    display: inline-block;
    min-width: 1.5ch;
    padding: 0 calc(0.3em + 2px) 0 0.3em;
    color: var(--color-on-hl);
    background: var(--color-hl);
    font-style: normal;
  }
</style>
