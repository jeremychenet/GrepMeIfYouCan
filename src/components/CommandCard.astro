---
// A command card (SPEC §2.4). `full` is the /c/<id> page; `compact` is a
// list item on tool and category pages and in search results, linking to the
// card page. Tags link to the search filtered by that tag. Lists show it as a
// row: title, command, description and tags, then Favorite and Copy on the right.
// src/components/ResultsList.ts fills a copy of this markup: keep them in sync.
// The Copy button (J12) is hidden until src/components/CommandTemplate.ts
// enables it, the Favorite button (J14) until FavoriteButton.ts does. The card
// page links to a prefilled GitHub issue to report a problem (J15).
import type { Command } from '../content/schema';
import { variableNames } from '../lib/template';
import { reportIssueUrl } from '../lib/github';
import { CATEGORY_LABELS, cardPath, categoryPath, sourceUrl, tagSearchPath, toolPath } from '../lib/pages';
import { canonicalUrl } from '../lib/site';
import CommandText from './CommandText.astro';
import DangerBadge from './DangerBadge.astro';
import NewTab from './NewTab.astro';

interface Props {
  card: Command;
  variant?: 'full' | 'compact';
  /** Heading level of a compact card, so pages keep a correct outline. */
  level?: 2 | 3;
}

const { card, variant = 'compact', level = 2 } = Astro.props;
const full = variant === 'full';
const Heading = full ? 'h1' : (`h${level}` as const);
const source = sourceUrl(card);
const hasVariables = variableNames(card.command).length > 0;
const reportUrl = full ? reportIssueUrl(card.id, canonicalUrl(Astro.site!.origin, cardPath(card.id))) : '';
---

<article
  class:list={['card', `card--${variant}`]}
  data-card={card.id}
  data-danger={card.danger}
  data-command={card.command}
>
  <div class="body">
    <div class="head">
      <Heading class="title">
        {full ? card.title : <a href={cardPath(card.id)}>{card.title}</a>}
      </Heading>
      <DangerBadge level={card.danger} />
      {
        full && (
          <button
            type="button"
            class="favorite"
            hidden
            data-favorite
            aria-pressed="false"
            aria-label={`Favorite: ${card.title}`}
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path
                d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z"
                stroke="currentColor"
                stroke-width="2"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        )
      }
    </div>

    {full && <p class="description">{card.description}</p>}

    {
      full && card.danger === 'destructive' && (
        <p class="danger-note" role="note">
          <strong>Destructive:</strong> this command can permanently delete data. Check every value
          before running it.
        </p>
      )
    }

    <div class="command-row">
      <CommandText command={card.command} scroll={full} />
      {
        full && (
          <button type="button" class="btn copy" hidden data-copy aria-label={`Copy command: ${card.title}`}>
            Copy
          </button>
        )
      }
    </div>

    {
      full && hasVariables && (
        <p class="hint">Edit the highlighted values, then copy. They are inserted as typed, without shell escaping.</p>
      )
    }

    {
      !full && (
        <div class="meta">
          <p class="description">{card.description}</p>
          <ul class="tags" aria-label="Tags">
            {card.tags.map((t) => (
              <li>
                <a href={tagSearchPath(t)} data-tag={t}>
                  {t}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      !full && (
        <p class="keyhint" aria-hidden="true">
          <span class="keyhint-vars">tab next value · </span>↵ copy · o open · f favorite
        </p>
      )
    }

    {
      full && (
        <dl class="meta">
          <div>
            <dt>Tool</dt>
            <dd>
              <a href={toolPath(card.tool)}>{card.tool}</a>
            </dd>
          </div>
          <div>
            <dt>Category</dt>
            <dd>
              <a href={categoryPath(card.category)}>{CATEGORY_LABELS[card.category]}</a>
            </dd>
          </div>
          {card.platforms && (
            <div>
              <dt>Platforms</dt>
              <dd>{card.platforms.join(', ')}</dd>
            </div>
          )}
          <div>
            <dt>Tags</dt>
            <dd>
              <ul class="tags">
                {card.tags.map((t) => (
                  <li>
                    <a href={tagSearchPath(t)} data-tag={t}>
                      {t}
                    </a>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        </dl>
      )
    }

    {
      full && (
        <p class="report">
          <a href={reportUrl} target="_blank" rel="noopener" data-report>
            Report an issue<NewTab />
          </a>{' '}
          <span>wrong command, wrong danger level, typo… (on GitHub)</span>
        </p>
      )
    }

    {
      full && source && card.source.type === 'tldr' && (
        <p class="attribution">
          Adapted from <a href={source}>tldr-pages ({card.source.page})</a>, licensed under{' '}
          <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
        </p>
      )
    }
  </div>

  {
    !full && (
      <div class="actions">
        <button
          type="button"
          class="favorite"
          hidden
          data-favorite
          aria-pressed="false"
          aria-label={`Favorite: ${card.title}`}
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z"
              stroke="currentColor"
              stroke-width="2"
              stroke-linejoin="round"></path>
          </svg>
        </button>
        <button type="button" class="btn copy" hidden data-copy aria-label={`Copy command: ${card.title}`}>
          Copy
        </button>
      </div>
    )
  }
</article>

<style>
  .card {
    min-width: 0;
  }

  .body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
  }

  .title {
    min-width: 0;
    font-weight: 400;
  }

  .title a {
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .tags a {
    display: inline-block;
    color: var(--color-text-faint);
    text-decoration: none;
  }

  .tags a::before {
    content: '#';
  }

  .tags a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .favorite {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    color: var(--color-text-faint);
    background: none;
    border: 0;
    cursor: pointer;
  }

  .favorite path {
    fill: none;
  }

  /* Before the script enables them, Copy and Favorite keep their place
     (invisible, out of the tab order), so the rows do not jump (CLS). */
  .actions > [hidden],
  .command-row > [hidden],
  .head > [hidden] {
    display: inline-flex !important;
    visibility: hidden;
  }

  .favorite:hover {
    color: var(--color-text);
  }

  .favorite[aria-pressed='true'] {
    color: var(--color-accent);
  }

  .favorite[aria-pressed='true'] path {
    fill: currentColor;
  }

  /* After a copy (CommandTemplate.ts): ink button for a moment. */
  .copy[data-state='done'] {
    color: var(--color-bg);
    background: var(--color-text);
    border-color: var(--color-text);
  }

  .card[data-danger='destructive'] .copy:not([data-state='done']) {
    color: var(--color-destructive);
    border-color: currentColor;
  }

  .card[data-danger='destructive'] .copy:not([data-state='done']):hover {
    color: var(--color-bg);
    background: var(--color-destructive);
    border-color: var(--color-destructive);
  }

  /* Touch screens: links are at least 44px tall (SPEC §3.3). */
  @media (pointer: coarse) {
    .favorite {
      width: var(--tap-min);
      height: var(--tap-min);
    }

    .title a,
    .report a,
    dd a {
      display: inline-flex;
      align-items: center;
      min-width: var(--tap-min);
      min-height: var(--tap-min);
    }

    dd .tags a {
      justify-content: center;
      min-width: var(--tap-min);
    }

    .card--full .meta div {
      align-items: center;
    }
  }

  /* ---- Row in a list (compact) ----
     Mobile: title with Favorite and Copy on its right, then the command and
     a two-line description; no tags. From 640px: body | buttons. */
  .card--compact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'head actions'
      'cmd cmd'
      'meta meta'
      'hint hint';
    column-gap: var(--space-2);
    align-items: center;
  }

  .card--compact .body {
    display: contents;
  }

  .card--compact .head {
    grid-area: head;
  }

  .card--compact .command-row {
    grid-area: cmd;
  }

  .card--compact .meta {
    grid-area: meta;
  }

  .card--compact .keyhint {
    grid-area: hint;
  }

  .card--compact .actions {
    grid-area: actions;
    gap: 0;
  }

  .card--compact .tags {
    display: none;
  }

  .card--compact .description {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .card--compact .title {
    color: var(--color-text-muted);
    font-size: var(--text-md);
  }

  .card--compact .command-row {
    margin-top: var(--space-1);
    font-size: var(--text-cmd);
  }

  .card--compact .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
    margin-top: var(--space-2);
  }

  .card--compact .description {
    min-width: 0;
    color: var(--color-text-faint);
    font-size: var(--text-sm);
  }

  .keyhint {
    display: none;
    margin-top: var(--space-2);
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .card:not(:has(var, .var-input)) .keyhint-vars {
    display: none;
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-2);
  }

  /* The active row of a keyboard list (CardList.astro): larger command,
     key hint, orange Copy button. */
  :global([aria-current='true']) > .card--compact .command-row {
    font-size: var(--text-xl);
  }

  :global([aria-current='true']) > .card--compact .keyhint {
    display: block;
  }

  :global([aria-current='true']) > .card--compact .copy:not([data-state='done']) {
    color: var(--color-on-accent);
    background: var(--color-accent-fill);
    border-color: var(--color-accent-fill);
  }

  :global([aria-current='true']) > .card--compact .copy:not([data-state='done'])::after {
    content: ' ↵';
    content: ' ↵' / '';
  }

  /* Touch screens: no keyboard hints, even if keyboard navigation started
     (e.g. a desktop browser switched to device emulation). SPEC §3.3. */
  @media (hover: none), (pointer: coarse) {
    :global([aria-current='true']) > .card--compact .keyhint {
      display: none;
    }

    :global([aria-current='true']) > .card--compact .copy:not([data-state='done'])::after {
      content: none;
    }

    :global([aria-current='true']) > .card--compact .command-row {
      font-size: var(--text-cmd);
    }

    :global([aria-current='true']) > .card--compact .copy:not([data-state='done']) {
      color: var(--color-text);
      background: transparent;
      border-color: var(--color-border-strong);
    }

    :global([aria-current='true']) > .card--compact[data-danger='destructive'] .copy:not([data-state='done']) {
      color: var(--color-destructive);
      border-color: currentColor;
    }
  }

  @media (min-width: 640px) {
    .card--compact {
      grid-template-areas: 'body actions';
      gap: var(--space-5);
    }

    .card--compact .body {
      display: flex;
      grid-area: body;
    }

    .card--compact .actions {
      gap: var(--space-2);
    }

    .card--compact .tags {
      display: flex;
    }

    .card--compact .description {
      display: block;
      flex: 0 1 auto;
      -webkit-line-clamp: none;
      line-clamp: none;
    }
  }

  /* ---- Card page (full) ---- */
  .card--full .body {
    gap: var(--space-5);
  }

  .card--full .head {
    padding-bottom: var(--space-2);
  }

  .card--full .title {
    flex: 1 1 12rem;
    font-size: var(--text-2xl);
    font-weight: 700;
  }

  .card--full .description {
    max-width: var(--prose-max);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .card--full .command-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-inline: calc(-1 * var(--gutter));
    padding: var(--space-6) var(--gutter);
    padding-left: calc(var(--gutter) - 6px);
    background: var(--color-surface);
    border-block: var(--rule-width) solid var(--color-border-strong);
    border-left: 6px solid var(--color-focus);
    font-size: var(--text-xl);
  }

  .card--full .command-row > :global(pre) {
    flex: 1 1 20rem;
    min-width: 0;
  }

  .card--full:not([data-danger='destructive']) .copy:not([data-state='done']) {
    color: var(--color-on-accent);
    background: var(--color-accent-fill);
    border-color: var(--color-accent-fill);
  }

  .hint {
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .danger-note {
    max-width: var(--prose-max);
    padding: var(--space-3) var(--space-4);
    color: var(--color-destructive);
    background: var(--color-destructive-bg);
    border-left: 6px solid currentColor;
  }

  .card--full .meta {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .card--full .meta div {
    display: flex;
    gap: var(--space-4);
  }

  dt {
    flex: none;
    width: 6rem;
    color: var(--color-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--text-xs);
    line-height: 1.6rem;
  }

  dd {
    margin: 0;
    min-width: 0;
  }

  dd a {
    color: var(--color-accent);
  }

  .card--full dd .tags {
    font-size: var(--text-sm);
  }

  .report {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .report a {
    color: var(--color-accent);
    font-weight: 700;
  }

  .report span {
    color: var(--color-text-faint);
  }

  .attribution {
    color: var(--color-text-faint);
    font-size: var(--text-sm);
  }

  .attribution a {
    color: var(--color-accent);
  }

  @media (min-width: 1024px) {
    .card--full .title {
      font-size: 2.75rem;
    }
  }
</style>
