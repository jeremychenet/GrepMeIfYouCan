---
// Search box, filters and results of the home page (SPEC §2.3). The markup
// is static; src/components/SearchBox.ts brings it to life. Result cards are
// copies of the templates of CardTemplates.astro.
import { CATEGORIES } from '../content/schema';
import { CATEGORY_LABELS } from '../lib/pages';
import { QUERY_MAX } from '../lib/search-state';
import CardList from './CardList.astro';
import CardTemplates from './CardTemplates.astro';
---

<section class="search" aria-label="Search" data-search>
  <div class="prompt bleed">
    <form class="search-form" role="search" action="/" method="get" data-search-form>
      <label for="search-input" class="ps"><span aria-hidden="true">$</span><span class="visually-hidden">Search commands</span></label>
      <input
        id="search-input"
        class="search-input"
        name="q"
        type="search"
        placeholder="find big files"
        maxlength={QUERY_MAX}
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="search"
        data-search-input
      />
    </form>
    <p class="status" role="status" data-search-status></p>
    <kbd class="esc" aria-hidden="true">esc</kbd>
  </div>

  <div class="filters bleed">
    <div class="chips" role="group" aria-label="Filter by category" data-category-chips>
      <button type="button" class="chip" data-cat="" aria-pressed="true">all</button>
      {
        CATEGORIES.map((c) => (
          <button type="button" class="chip" data-cat={c} aria-pressed="false">
            {CATEGORY_LABELS[c]}
          </button>
        ))
      }
    </div>
    <div class="active-tags" role="group" aria-label="Active tag filters" hidden data-active-tags>
    </div>
  </div>

  <div hidden data-search-results>
    <CardList label="Search results" />
  </div>

  <p class="empty" hidden data-search-empty>
    No command matches your search.
    <a href="#" data-suggest-link>Suggest this command</a>
  </p>

  <CardTemplates />
  <template data-tag-chip-template>
    <button type="button" class="chip chip--tag">
      <span data-tag-name></span>
      <span aria-hidden="true">×</span>
    </button>
  </template>
</section>

<script>
  import './SearchBox';
</script>

<style>
  .search {
    display: flex;
    flex-direction: column;
  }

  /* Black terminal band: $ prompt, the query, the result count. */
  .prompt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-4);
    color: var(--color-term-text);
    background: var(--color-term-bg);
    font-family: var(--font-mono);
  }

  .search-form {
    display: flex;
    flex: 1 1 16rem;
    align-items: center;
    gap: var(--space-4);
    min-width: 0;
  }

  .ps {
    color: var(--color-accent-fill);
    font-size: var(--text-xl);
  }

  .search-input {
    flex: 1;
    min-width: 0;
    min-height: var(--tap-min);
    padding: 0;
    color: var(--color-term-text);
    background: transparent;
    border: 0;
    border-radius: 0;
    caret-color: var(--color-accent-fill);
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    -webkit-appearance: none;
    appearance: none;
  }

  .search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .search-input::placeholder {
    color: var(--color-term-muted);
    opacity: 1;
  }

  /* The band itself shows where the focus is. */
  .search-input:focus-visible {
    outline: none;
  }

  .prompt:focus-within {
    box-shadow: inset 0 calc(-1 * var(--focus-width)) 0 var(--color-accent-fill);
  }

  .status {
    color: var(--color-term-muted);
    font-size: var(--text-sm);
  }

  .status:empty {
    display: none;
  }

  .esc {
    color: var(--color-term-text);
    border-color: var(--color-term-muted);
  }

  /* No Escape key to hint at on touch screens or narrow windows. */
  @media (max-width: 639px), (hover: none) and (pointer: coarse) {
    .esc {
      display: none;
    }
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
    border-bottom: var(--rule-width) solid var(--color-border-strong);
  }

  .chips,
  .active-tags {
    display: flex;
    gap: var(--space-2);
  }

  /* Mobile: categories scroll sideways instead of wrapping (SPEC §3.3). */
  .chips {
    max-width: 100%;
    overflow-x: auto;
  }

  .active-tags {
    flex-wrap: wrap;
  }

  .chip {
    flex: none;
    min-height: 1.875rem;
    padding: 0 var(--space-3);
    color: var(--color-text);
    background: transparent;
    border: 1.5px solid var(--color-border);
    border-radius: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: lowercase;
    cursor: pointer;
  }

  .chip:hover {
    border-color: var(--color-border-strong);
  }

  .chip[aria-pressed='true'] {
    color: var(--color-bg);
    background: var(--color-text);
    border-color: var(--color-text);
  }

  .chip--tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border-color: var(--color-border-strong);
  }

  @media (pointer: coarse) {
    .chip {
      min-height: var(--tap-min);
    }
  }

  .empty {
    padding-block: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--text-md);
    border-bottom: 1px solid var(--color-border);
  }

  .empty a {
    color: var(--color-accent);
  }

  @media (max-width: 639px) {
    .ps,
    .search-input {
      font-size: var(--text-lg);
    }
  }
</style>
