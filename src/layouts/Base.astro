---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConfirmDialog from '../components/ConfirmDialog.astro';
import ShortcutsHelp from '../components/ShortcutsHelp.astro';
import Toast from '../components/Toast.astro';
import KeyBar from '../components/KeyBar.astro';
import { canonicalUrl } from '../lib/site';
import { umamiWebsiteId } from '../lib/analytics';

interface Props {
  title?: string;
  description?: string;
  /** Error pages: not indexed, no canonical URL (they have no URL of their own). */
  noindex?: boolean;
}

const SITE = 'GrepMeIfYouCan';
const {
  title,
  description = 'Find, adapt and copy the right shell command in seconds.',
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE}` : SITE;
const canonical = canonicalUrl(Astro.site!.origin, Astro.url.pathname);
// Without an id (CI, Lighthouse, plain `make up`) no tracker is added.
const umami = umamiWebsiteId(import.meta.env);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={title ?? SITE} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta name="color-scheme" content="dark light" />
    <!-- Blocking on purpose: sets the theme before first paint (no flash). -->
    <script is:inline src="/theme-init.js"></script>
    {
      // Audience statistics (SPEC §6.4): same origin, deferred, never blocks
      // rendering. Page views drop ?query, so searches are not recorded.
      // Do Not Track is not followed (SPEC §6.4, Privacy page).
      umami && (
        <script
          is:inline
          defer
          src="/stats/script.js"
          data-website-id={umami}
          data-host-url="/stats"
          data-exclude-search="true"
          data-exclude-hash="true"
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="container" tabindex="-1">
      <slot />
    </main>
    <KeyBar />
    <Footer />
    <p id="var-hint" class="visually-hidden">
      Values are inserted in the command as typed, without shell escaping.
    </p>
    <Toast />
    <ConfirmDialog />
    <ShortcutsHelp />
    <!-- One entry module for the islands every page uses (fewer requests
         before first paint, SPEC §8); pages add their own (search, saved lists). -->
    <script>
      import '../components/ThemeToggle';
      import '../components/CommandTemplate';
      import '../components/ShortcutsHelp';
      import '../components/KeyboardNav';
    </script>
  </body>
</html>
