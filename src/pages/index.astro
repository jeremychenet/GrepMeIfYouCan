---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SearchApp from '../components/SearchApp.astro';
import { CATEGORIES } from '../content/schema';
import { CATEGORY_LABELS, categoryPath } from '../lib/pages';

// Search first; the category list shows while there is nothing to search.
const cards = (await getCollection('commands')).map((e) => e.data);
const categories = CATEGORIES.map((category) => {
  const inCategory = cards.filter((c) => c.category === category);
  return {
    category,
    count: inCategory.length,
    tools: new Set(inCategory.map((c) => c.tool)).size,
  };
}).filter((c) => c.count > 0);
---

<Base>
  <h1>Find the right shell command</h1>
  <p class="muted lead">
    Search, adapt and copy Linux, container, cloud and Git commands in seconds.
  </p>

  <SearchApp />

  <div data-browse>
    <h2>Browse by category</h2>
    <ul class="categories">
      {
        categories.map(({ category, count, tools }) => (
          <li>
            <a href={categoryPath(category)}>
              <span class="name">{CATEGORY_LABELS[category]}</span>
              <span class="muted">
                {count} commands, {tools} tools
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  h1 {
    font-size: var(--text-xl);
  }

  .lead {
    margin-block: var(--space-2) var(--space-6);
  }

  h2 {
    margin-bottom: var(--space-3);
    font-size: var(--text-lg);
  }

  .categories {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .categories a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
  }

  .categories a:hover {
    border-color: var(--color-accent);
  }

  .name {
    color: var(--color-text);
    font-weight: 600;
  }

  .categories .muted {
    font-size: var(--text-sm);
  }

  @media (min-width: 640px) {
    h1 {
      font-size: var(--text-2xl);
    }

    .categories {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .categories {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
