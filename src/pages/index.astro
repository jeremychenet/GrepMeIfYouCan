---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SearchApp from '../components/SearchApp.astro';
import { CATEGORIES } from '../content/schema';
import { CATEGORY_LABELS, categoryPath, countLabel } from '../lib/pages';

// Search first; the category list shows while there is nothing to search.
const cards = (await getCollection('commands')).map((e) => e.data);
const categories = CATEGORIES.map((category) => {
  const inCategory = cards.filter((c) => c.category === category);
  return {
    category,
    count: inCategory.length,
    tools: new Set(inCategory.map((c) => c.tool)).size,
  };
}).filter((c) => c.count > 0);
---

<Base>
  <!-- The promise of the site (SPEC §3.1): faster than asking an LLM. -->
  <h1 class="tagline">
    Faster than asking your LLM: type a few words, copy the command you had in mind in under 5 seconds.
  </h1>

  <SearchApp />

  <div class="browse" data-browse>
    <h2 class="eyebrow">Browse by category</h2>
    <ol class="categories">
      {
        categories.map(({ category, count, tools }) => (
          <li>
            <a href={categoryPath(category)}>
              <span class="name">{CATEGORY_LABELS[category]}</span>
              <span class="meta">
                {countLabel(count, 'command')}<span class="tools"> · {countLabel(tools, 'tool')}</span>
              </span>
              <span class="go" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<style>
  .tagline {
    max-width: var(--prose-max);
    padding-block: var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--text-md);
    font-weight: 400;
    line-height: 1.4;
    color: var(--color-text);
  }

  .browse h2 {
    padding-block: var(--space-4) var(--space-2);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .categories {
    padding-block: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
    counter-reset: row;
  }

  .categories li {
    counter-increment: row;
    border-bottom: 1px solid var(--color-border);
  }

  .categories a {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: baseline;
    gap: 0 var(--space-4);
    padding-block: var(--space-3);
    text-decoration: none;
  }

  .categories a::before {
    content: counter(row, decimal-leading-zero);
    grid-row: span 2;
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .categories a:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }

  .categories a:hover::before,
  .categories a:hover .go {
    color: var(--color-accent);
  }

  .name {
    font-family: var(--font-cond);
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .meta {
    grid-column: 2;
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .go {
    grid-row: 1 / span 2;
    grid-column: 3;
    align-self: center;
    font-family: var(--font-mono);
    font-size: var(--text-xl);
  }

  /* Categories with the gutter of the page, with a full-width hover band. */
  .categories {
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: 0;
  }

  .categories a {
    padding-inline: var(--gutter);
  }

  /* The home page fits the screen with its footer in view (SPEC §3.1). */
  :global(main:has(.browse)) {
    padding-bottom: var(--space-4);
  }

  /* Phones: one line per category, so the footer links stay in view. */
  @media (max-width: 639px) {
    .browse h2 {
      padding-block: var(--space-3) var(--space-1);
    }

    .categories a {
      grid-template-columns: 2rem 1fr auto auto;
      align-items: center;
      min-height: var(--tap-min);
      padding-block: var(--space-2);
    }

    .categories a::before {
      grid-row: auto;
    }

    .name {
      font-size: var(--text-lg);
    }

    .meta {
      grid-column: 3;
    }

    .tools {
      display: none;
    }

    .go {
      grid-row: auto;
      grid-column: 4;
      font-size: var(--text-lg);
    }
  }

  @media (min-width: 1024px) {
    .tagline {
      font-size: var(--text-lg);
    }

    .categories {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .categories li:nth-child(odd) {
      border-right: 1px solid var(--color-border);
    }
  }
</style>
