---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SearchApp from '../components/SearchApp.astro';
import { CATEGORIES } from '../content/schema';
import { CATEGORY_LABELS, categoryPath } from '../lib/pages';

// Search first; the category list shows while there is nothing to search.
const cards = (await getCollection('commands')).map((e) => e.data);
const categories = CATEGORIES.map((category) => {
  const inCategory = cards.filter((c) => c.category === category);
  return {
    category,
    count: inCategory.length,
    tools: new Set(inCategory.map((c) => c.tool)).size,
  };
}).filter((c) => c.count > 0);
---

<Base>
  <h1 class="visually-hidden">Find the right shell command</h1>

  <SearchApp />

  <div class="browse" data-browse>
    <h2 class="eyebrow">Browse by category</h2>
    <ol class="categories">
      {
        categories.map(({ category, count, tools }) => (
          <li>
            <a href={categoryPath(category)}>
              <span class="name">{CATEGORY_LABELS[category]}</span>
              <span class="meta">
                {count} commands · {tools} tools
              </span>
              <span class="go" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ol>
    <p class="lead">
      Search, adapt and copy Linux, Unix, container, cloud and Git commands in seconds: type a few
      words, edit the <mark>highlighted values</mark>, copy.
    </p>
  </div>
</Base>

<style>
  .browse h2 {
    padding-block: var(--space-6) var(--space-3);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .categories {
    padding-block: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
    counter-reset: row;
  }

  .categories li {
    counter-increment: row;
    border-bottom: 1px solid var(--color-border);
  }

  .categories a {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-5);
    text-decoration: none;
  }

  .categories a::before {
    content: counter(row, decimal-leading-zero);
    grid-row: span 2;
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .categories a:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }

  .categories a:hover::before,
  .categories a:hover .go {
    color: var(--color-accent);
  }

  .name {
    font-family: var(--font-cond);
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .meta {
    grid-column: 2;
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .go {
    grid-row: 1 / span 2;
    grid-column: 3;
    align-self: center;
    font-family: var(--font-mono);
    font-size: var(--text-xl);
  }

  /* Categories with the gutter of the page, with a full-width hover band. */
  .categories {
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: 0;
  }

  .categories a {
    padding-inline: var(--gutter);
  }

  .lead {
    max-width: var(--prose-max);
    padding-top: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-md);
  }

  mark {
    padding: 0 0.3em;
    color: var(--color-on-hl);
    background: var(--color-hl);
  }

  @media (min-width: 1024px) {
    .categories {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .categories li:nth-child(odd) {
      border-right: 1px solid var(--color-border);
    }
  }
</style>
