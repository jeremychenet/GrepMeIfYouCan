---
import Base from '../layouts/Base.astro';
import SavedList from '../components/SavedList.astro';
---

<Base title="Favorites" description="Your favorite commands, kept in this browser only.">
  <header class="page-head">
    <h1>Favorites</h1>
    <p class="lead">Kept in this browser only. Export them to save a copy or move them to another device.</p>
  </header>
  <SavedList list="favorites" />
</Base>
