---
import Base from '../layouts/Base.astro';
import SavedList from '../components/SavedList.astro';
---

<Base title="Favorites" description="Your favorite commands, kept in this browser only.">
  <h1>Favorites</h1>
  <p class="muted lead">Kept in this browser only. Export them to save a copy or move them to another device.</p>
  <SavedList list="favorites" />
</Base>

<style>
  h1 {
    font-size: var(--text-xl);
  }

  .lead {
    margin-block: var(--space-2) var(--space-6);
  }

  @media (min-width: 640px) {
    h1 {
      font-size: var(--text-2xl);
    }
  }
</style>
