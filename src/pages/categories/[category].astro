---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import CardList from '../../components/CardList.astro';
import CommandCard from '../../components/CommandCard.astro';
import Base from '../../layouts/Base.astro';
import type { Command } from '../../content/schema';
import { CATEGORY_LABELS, categoryPageMeta, groupBy, toolPath } from '../../lib/pages';

export const getStaticPaths = (async () => {
  const cards = (await getCollection('commands')).map((e) => e.data);
  return [...groupBy(cards, (c) => c.category)].map(([category, list]) => ({
    params: { category },
    props: { category: category as Command['category'], cards: list },
  }));
}) satisfies GetStaticPaths;

const { category, cards } = Astro.props;
const meta = categoryPageMeta(category, cards);
const byTool = groupBy(cards, (c) => c.tool);
---

<Base title={meta.title} description={meta.description}>
  <header class="page-head">
    <h1>{CATEGORY_LABELS[category]}</h1>
    <p class="count">{cards.length} commands across {byTool.size} tools</p>
  </header>
  {
    [...byTool].map(([tool, list]) => (
      <section aria-labelledby={`tool-${tool}`}>
        <h2 id={`tool-${tool}`}>
          <a href={toolPath(tool)}>
            <code>{tool}</code>
          </a>
        </h2>
        <CardList label={`${tool} commands`}>
          {list.map((card) => (
            <li>
              <CommandCard card={card} level={3} />
            </li>
          ))}
        </CardList>
      </section>
    ))
  }
</Base>

<style>
  h2 {
    padding-block: var(--space-6) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    border-bottom: 1px solid var(--color-border);
  }

  h2 a {
    text-decoration: none;
  }

  /* Touch screens: links are at least 44px tall (SPEC §3.3). */
  @media (pointer: coarse) {
    h2 {
      padding-top: var(--space-3);
      padding-bottom: 0;
    }

    h2 a {
      display: inline-flex;
      align-items: center;
      min-width: var(--tap-min);
      min-height: var(--tap-min);
    }
  }

  h2 a::after {
    content: ' →';
    color: var(--color-text-faint);
  }

  h2 a:hover {
    color: var(--color-accent);
  }

  h2 code {
    font-weight: 700;
  }
</style>
