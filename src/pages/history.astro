---
import Base from '../layouts/Base.astro';
import SavedList from '../components/SavedList.astro';
import { HISTORY_MAX } from '../lib/store';
---

<Base title="History" description="The commands you copied, kept in this browser only.">
  <header class="page-head">
    <h1>History</h1>
    <p class="lead">The last {HISTORY_MAX} commands you copied, kept in this browser only. Searches are never recorded.</p>
  </header>
  <SavedList list="history" />
</Base>
