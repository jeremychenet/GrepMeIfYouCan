---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import CommandCard from '../../components/CommandCard.astro';
import Base from '../../layouts/Base.astro';
import { CATEGORY_LABELS, categoryPath, toolPath } from '../../lib/pages';

export const getStaticPaths = (async () => {
  const cards = await getCollection('commands');
  return cards.map(({ data }) => ({ params: { id: data.id }, props: { card: data } }));
}) satisfies GetStaticPaths;

const { card } = Astro.props;
---

<Base title={card.title} description={card.description}>
  <nav aria-label="Breadcrumb" class="breadcrumb">
    <ol>
      <li><a href={categoryPath(card.category)}>{CATEGORY_LABELS[card.category]}</a></li>
      <li><a href={toolPath(card.tool)}>{card.tool}</a></li>
    </ol>
  </nav>
  <CommandCard card={card} variant="full" />
</Base>

<style>
  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-6) 0 var(--space-3);
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  /* Touch screens: links are at least 44px (SPEC §3.3). */
  @media (pointer: coarse) {
    .breadcrumb ol {
      align-items: center;
      padding-block: var(--space-3) 0;
    }

    .breadcrumb a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: var(--tap-min);
      min-height: var(--tap-min);
    }
  }

  .breadcrumb li + li::before {
    content: '/';
    margin-right: var(--space-2);
    color: var(--color-text-faint);
  }
</style>
