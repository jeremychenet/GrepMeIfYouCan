# Copy to .env (never commit .env).

# Lets plain `docker compose` use the same files as the Makefile.
COMPOSE_FILE=compose.yaml:compose.dev.yaml

# Set to true if hot reload does not detect file changes on macOS bind mounts.
WATCH_POLLING=false

# Public URL of the site (used from J2, once the proxy exists).
PUBLIC_BASE_URL=http://localhost:8080
