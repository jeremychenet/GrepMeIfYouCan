# Copy to .env (never commit .env).

# Lets plain `docker compose` use the same files as the Makefile.
COMPOSE_FILE=compose.yaml:compose.dev.yaml

# Set to true if hot reload does not detect file changes on macOS bind mounts.
WATCH_POLLING=false

# Public URL of the site (used from J2, once the proxy exists).
PUBLIC_BASE_URL=http://localhost:8080

# --- Analytics (make up-analytics, SPEC §6.4) ---
# Generate each secret with: openssl rand -hex 32 (hex only: the DB password
# goes into a connection URL).
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
# Id of the site in Umami (Settings > Websites, after the first login on
# http://127.0.0.1:3001). Empty: no tracker script in the pages.
PUBLIC_UMAMI_WEBSITE_ID=
